# Configuración Pública de Supabase (Seguro para el cliente gracias a Row Level Security)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# IMPORTANTE DE SEGURIDAD (Ley 25.326):
# NUNCA coloques GEMINI_API_KEY ni SUPABASE_SERVICE_ROLE_KEY en archivos .env del frontend.
# Configúralos exclusivamente en el servidor de Supabase mediante:
#   supabase secrets set GEMINI_API_KEY=tu_clave_gemini
#   supabase secrets set ALLOWED_ORIGIN=https://tu-dominio.vercel.app
